soong_namespace {
    imports: [
        "hardware/mediatek",
    ],
}

cc_library_shared {
    name: "libgpud_shim",
    vendor: true,
    srcs: ["shims/gpud_shim.c"],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}

// The camera libraries ship OpenCL kernels precompiled for the old r32p1 driver.
// This ICD front-end converts them for the r49p1 driver while loading them and
// forwards everything else to the stock ICD loader (libOpenCL_real.so).
cc_library_shared {
    name: "libOpenCL",
    vendor: true,
    compile_multilib: "64",
    srcs: [
        "shims/opencl/opencl_shim.c",
        "shims/opencl/stubs.S",
    ],
    shared_libs: ["liblog"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wno-unused-parameter",
        "-mno-outline-atomics",
    ],
}

// Sends AT commands through the mtkradioex HAL (like EngineerMode does).
// `em_at --iran` configures the modem's IMS profile for Iranian SIMs once.
cc_binary {
    name: "em_at",
    system_ext_specific: true,
    srcs: ["tools/em_at/em_at.cpp"],
    init_rc: ["tools/em_at/em_at.rc"],
    shared_libs: [
        "libbase",
        "libhidlbase",
        "libutils",
        "liblog",
        "vendor.mediatek.hardware.mtkradioex@3.0",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
